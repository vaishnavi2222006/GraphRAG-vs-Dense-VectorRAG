LOG_LEVEL=INFO
APP_DATA_DIR=./data/runtime
UPLOAD_DIR=./data/uploads
SQLITE_PATH=./data/runtime/rag_benchmark_lab.sqlite3

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=change-me

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_chunks

# Primary LLM Provider: groq (default), gemini, or ollama
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_TIMEOUT_SECONDS=60

# Optional Alternative Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=60

# Optional Alternative Provider: Local Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_RETRIES=2
LLM_MOCK_MODE=false

# Optional Per-Query Cost & Pricing Configuration (USD per 1,000,000 tokens)
# If not specified, verified official rates for catalog models (e.g. llama-3.3-70b-versatile, gemini-2.5-flash) are used.
# If a custom or preview model without published rates is used, set these to compute cost; otherwise "Cost unavailable" is shown.
LLM_INPUT_COST_PER_MTOK=0.59
LLM_OUTPUT_COST_PER_MTOK=0.79
USD_TO_INR_RATE=86.5

EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=900
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
GRAPH_MAX_HOPS=2
GRAPH_MAX_RESULTS=20
RRF_K=60

EVALUATION_MODEL=llama3.1:8b-instruct-q4_K_M
EVALUATION_TIMEOUT=120
UPLOAD_SIZE_LIMIT_MB=25
